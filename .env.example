# ---- 服务 ----
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data

# ---- LLM（OpenAI 兼容 chat/completions 接口）----
# 例：OpenRouter  https://openrouter.ai/api/v1
#     DeepSeek    https://api.deepseek.com/v1
#     本地 Ollama http://127.0.0.1:11434/v1
# 不填 LLM_API_KEY 时，AI 使用内置的几句随机回复兜底（demo 也能跑）。
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
LLM_TEMPERATURE=0.9
# 设为 1 则把用户刚发的图片以 image_url 形式一起发给模型（需要模型支持视觉）
LLM_VISION=0

# ---- 名字与人设 ----
USER_NAME=我
AI_NAME=AI
PERSONA_FILE=persona.example.md

# ---- 虚拟钱包 ----
USER_INIT_BALANCE=1000
AI_INIT_BALANCE=1000
# 单个红包 / 转账金额上限
PACKET_MAX_SINGLE=200
# AI 每天最多主动发出的红包+转账总额
AI_DAILY_LIMIT=300
# 红包 / 转账多少小时没人领就过期退回
PACKET_EXPIRE_HOURS=24

# ---- AI 送礼 ----
# AI 每天最多送几件礼物
AI_GIFT_DAILY_LIMIT=2
# AI 单件礼物最高价格
AI_GIFT_MAX_PRICE=300

# ---- 聊天行为 ----
# 回复节奏倍率：1 为正常，0 为不等待（测试用）
REPLY_DELAY_SCALE=1
# 用户连发消息后等几秒再一起回复
REPLY_DEBOUNCE_SECONDS=4
# 是否开启「AI 手滑发出去一半，撤回再重发」
AI_RECALL_RETYPE=0
AI_RECALL_RETYPE_PROB=0.04
# 送给模型的最近消息条数
HISTORY_LIMIT=30

# ---- 开发调试（默认关）----
# 设为 1 会开放 /api/dev/ai_say，可以把一段文本当作 AI 回复喂给标记解析器
DEV_API=0
